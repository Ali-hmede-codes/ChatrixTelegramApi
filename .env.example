# Telegram credentials (from my.telegram.org)
API_ID=
API_HASH=
SESSION=

# Server
PORT=3000
HOST=0.0.0.0

# Telegram connection
USE_WSS=true
CONNECTION_RETRIES=5
REQUEST_RETRIES=5
DOWNLOAD_RETRIES=3
TIMEOUT=10
FLOOD_SLEEP_THRESHOLD=60

# Messages
DEFAULT_MESSAGE_LIMIT=20
MAX_MESSAGE_LIMIT=100

# Media cache
MEDIA_DIR=media
MAX_CACHE_SIZE_MB=500

# Real-time events
REALTIME_ENABLED=true
REALTIME_CHANNELS=

# Deduplication
DEDUP_ENABLED=true
DEDUP_WINDOW_HOURS=1
DEDUP_SIMILARITY_THRESHOLD=0.75

# Feed
FEED_DEFAULT_LIMIT=50
FEED_MAX_LIMIT=200
FEED_DEFAULT_HOURS=1